# Copy to .env and fill credentials locally. Never commit .env or secret files.

# Cross-platform path overrides (optional; defaults to configs/project.yaml + auto-detection)
HANVIET_PROJECT_ROOT=
HANVIET_DATA_ROOT=
HANVIET_OUTPUT_ROOT=
HANVIET_RESOURCES_ROOT=
HANVIET_CACHE_DIR=
HANVIET_ENV=auto
HANVIET_DEVICE=auto

# External OCR binaries (optional if already on PATH)
TESSERACT_CMD=
TESSDATA_PREFIX=

# Kim Han Nom (CLC) API credentials (separate endpoints for OCR vs Sentence Alignment)
CLC_API_KEY=
CLC_OCR_API_KEY=

# LLM Verification & Repair (leave blank to run traditional stages with status LLM_NOT_RUN)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
