{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hanviet.ocr_record.v1",
  "title": "Shared OCR Result Record",
  "type": "object",
  "required": [
    "record_id",
    "source_id",
    "region_id",
    "work_id",
    "corpus_id",
    "member_id",
    "variant",
    "pdf_page",
    "reading_order",
    "engine",
    "model_version",
    "text",
    "bbox",
    "confidence",
    "image_reference",
    "input_sha256",
    "status"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "region_id": {"type": ["string", "integer"]},
    "work_id": {"type": "string", "minLength": 1},
    "corpus_id": {"type": "string", "minLength": 1},
    "member_id": {"type": "string", "minLength": 1},
    "variant": {"type": "string", "enum": ["han", "dich_am", "dich_nghia", "dich_tho"]},
    "pdf_page": {"type": ["integer", "null"]},
    "reading_order": {"type": ["integer", "null"]},
    "engine": {"type": "string", "minLength": 1},
    "model_version": {"type": "string"},
    "text": {"type": "string"},
    "bbox": {"type": ["array", "null"]},
    "confidence": {"type": ["number", "null"]},
    "image_reference": {"type": "string"},
    "input_sha256": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["OK", "FAILED", "UNPROCESSED", "IMPORTED", "NEEDS_REVIEW", "EMPTY"]},
    "coordinate_space": {"type": ["string", "null"]},
    "preprocess_transform": {"type": ["object", "null"]}
  }
}
