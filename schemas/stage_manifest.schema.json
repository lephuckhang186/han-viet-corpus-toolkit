{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hanviet.stage_manifest.v1",
  "title": "Independent Stage Execution Manifest",
  "type": "object",
  "required": [
    "schema",
    "stage",
    "version",
    "created_at_utc",
    "input_fingerprint",
    "output_fingerprint",
    "review_status",
    "config_snapshot",
    "input_manifest",
    "output_manifest",
    "statistics",
    "error_log"
  ],
  "properties": {
    "schema": {"type": "string", "const": "hanviet.stage_manifest.v1"},
    "stage": {"type": "string"},
    "version": {"type": "string"},
    "created_at_utc": {"type": "string"},
    "input_fingerprint": {"type": "string"},
    "output_fingerprint": {"type": "string"},
    "review_status": {"type": "string"},
    "config_snapshot": {"type": "object"},
    "input_manifest": {"type": ["object", "array"]},
    "output_manifest": {"type": ["object", "array"]},
    "statistics": {"type": "object"},
    "error_log": {"type": "array"}
  }
}
